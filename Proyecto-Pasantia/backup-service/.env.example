# Copia este archivo a .env y completa los valores.
# La SUPABASE_SERVICE_KEY es la "service_role" key del dashboard de Supabase
# (Settings → API → service_role). Tiene acceso completo, NO la expongas al frontend.

SUPABASE_URL=https://seprshcsntiuzosgijpr.supabase.co
SUPABASE_SERVICE_KEY=TU_SERVICE_ROLE_KEY_AQUI

# Directorio donde se almacenan los backups (dentro del contenedor)
BACKUP_DIR=/backups

# Cron: 23:59 todos los días
CRON_SCHEDULE=59 23 * * *

# Puerto del servicio
PORT=4000
